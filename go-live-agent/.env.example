DEFECTDOJO_BASE_URL=http://nginx:8080
DEFECTDOJO_API_TOKEN=change-me

# LLM está desactivado por defecto — no se envía ningún dato a servicios externos
LLM_ENABLED=false

# Proveedor: groq (predeterminado) | openai | fake (pruebas)
LLM_PROVIDER=groq
LLM_MODEL=llama3-70b-8192

# Clave del proveedor seleccionado (solo si LLM_ENABLED=true)
GROQ_API_KEY=change-me
OPENAI_API_KEY=change-me
